# =============================================================================
# IoT (Inception of Things) - Environment Configuration Example
# =============================================================================
# Copy this file to .env.local and customize for your environment.
# NEVER commit .env.local files with real secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# NETWORK CONFIGURATION (Vagrant VMs)
# -----------------------------------------------------------------------------
# IP addresses used by VirtualBox network adapters
# Change if you need different IPs in the school lab
SERVER_IP=192.168.56.110
WORKER_IP=192.168.56.111

# Network interface name (usually eth0 or enpXsX)
# Auto-detected in scripts, override if needed
NETWORK_INTERFACE=eth0

# -----------------------------------------------------------------------------
# K3S CLUSTER CONFIGURATION
# -----------------------------------------------------------------------------
# The k3s server token is AUTO-GENERATED and stored at:
# /var/lib/rancher/k3s/server/token (on the master node)
# Do NOT set this manually unless restoring a cluster!
# K3S_TOKEN=<auto-generated>  # <-- Don't fill in, it's auto-created

# Port for accessing Kubernetes API externally (optional)
KUBE_API_PORT=6443

# -----------------------------------------------------------------------------
# K3D CLUSTER NAMES
# -----------------------------------------------------------------------------
# Change if you want multiple concurrent clusters
CLUSTER_NAME_P3=iot-cluster
CLUSTER_NAME_BONUS=bonus-cluster

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (P2)
# -----------------------------------------------------------------------------
# Images used in deployments
APP1_IMAGE=traefik/whoami
APP2_IMAGE=traefik/whoami
APP3_IMAGE=traefik/whoami

# Replica counts
APP1_REPLICAS=1
APP2_REPLICAS=3
APP3_REPLICAS=1

# -----------------------------------------------------------------------------
# PLAYGROUND APP (P3)
# -----------------------------------------------------------------------------
# IMPORTANT: Change from v1 to v2 after the "defensa" (defense/evaluation)
PLAYGROUND_IMAGE=rmarcas42/playground
PLAYGROUND_VERSION=v1  # <-- CHANGE TO v2 FOR DEFENSE!

# Port mapping
PLAYGROUND_PORT=8888
TRAEFIK_LB_PORT=8080

# -----------------------------------------------------------------------------
# BONUS - GITLAB CONFIGURATION
# -----------------------------------------------------------------------------
# GitLab CE instance URL (auto-configured, override for custom setup)
GITLAB_URL=http://127.0.0.1.nip.io
GITLAB_PORT=8929

# Initial root password is AUTO-GENERATED by GitLab Helm chart
# Retrieved via: kubectl get secret -n gitlab ... | base64 --decode
# Do NOT hardcode real passwords here!
GITLAB_ADMIN_USER=admin
# GITLAB_ADMIN_PASSWORD=<auto-generated>  # <-- Use kubectl command to retrieve

# Resource limits for school computers (RAM constrained)
GITLAB_WEBSERVICE_MEMORY=512Mi
GITLAB_POSTGRES_MEMORY=256Mi
GITLAB_REDIS_MEMORY=128Mi
GITALY_MEMORY=256Mi

# -----------------------------------------------------------------------------
# BONUS - ARGOCD CONFIGURATION
# -----------------------------------------------------------------------------
ArGoCD UI port (NodePort)
ARGOCD_UI_PORT=30080
ARGOCD_INTERNAL_PORT=8080

# ArgoCD admin credentials are AUTO-GENERATED
# Retrieved via: kubectl get secret argocd-initial-admin-secret -n argocd | base64 --decode
ARGOCD_ADMIN_USER=admin
# ARGOCD_ADMIN_PASSWORD=<auto-generated>  # <-- Use kubectl command to retrieve

# ArgoCD Application source (GitLab repository)
ARGOCD_REPO_URL=http://gitlab-webservice-default.gitlab.svc.cluster.local/rmarcas/playground.git
ARGOCD_TARGET_BRANCH=main  # or 'master' - verify which branch your repo uses!

# -----------------------------------------------------------------------------
# NODEJS / OTHER (if needed for IoT apps)
# -----------------------------------------------------------------------------
# Only if you add Node.js sensors/APIs later
# PORT=3000
# API_SECRET=my-secret-key
